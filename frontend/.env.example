# Public URL of the backend API. Baked into the browser bundle at build time.
# Leave unset when the site and API share one origin (a load balancer routing /api and /ws).
# On Vercel (free tier) set this to your Hugging Face Space's direct URL, e.g.
#   https://<your-username>-<space-name>.hf.space
# The WebSocket URL is derived from it (https -> wss); NEXT_PUBLIC_WS_URL is only an override.
# For local development the backend runs on port 8000 of your own machine:
NEXT_PUBLIC_API_URL=http://localhost:8000
