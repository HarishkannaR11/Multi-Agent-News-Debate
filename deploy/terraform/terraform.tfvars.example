# Copy this file to terraform.tfvars and fill it in. terraform.tfvars is git-ignored; never commit real keys.
# Safer alternative: leave the secrets out of the file and pass them as environment variables:
#   export TF_VAR_groq_api_key=...  TF_VAR_admin_token=...  TF_VAR_newsapi_key=...

aws_region = "us-east-1"

# Secrets (the admin token: openssl rand -hex 24)
groq_api_key  = ""
newsapi_key   = ""   # NewsAPI and/or GNews: at least one is required
gnews_api_key = ""
admin_token   = ""

# Where alarms and budget warnings go (confirm the "Subscription Confirmation" email AWS sends)
alert_email        = "you@example.com"
monthly_budget_usd = 40

# Server size: pick one your account may use (EC2 console -> Launch instance shows "Free tier eligible")
instance_type = "c7i-flex.large"

# Which code to deploy
git_ref = "claude/exciting-faraday-lphld3"

# Optional AWS WAF in front of CloudFront (about 8 USD a month)
enable_waf = false

# --- Your own domain (optional; see docs/DEPLOY_TERRAFORM.md, "Use your own domain") ---------------------------
# Leave domain_name empty to use the free https://dxxxx.cloudfront.net address.
# It takes TWO applies: first with attach_domain = false, then true once the certificate is Issued.
domain_name        = ""                       # e.g. "krisharish.space"
extra_domain_names = []                       # e.g. ["www.krisharish.space"]
dns_provider       = "route53"                # "route53" (AWS hosts the DNS, easiest) or "registrar" (you add the records by hand)
route53_zone_name  = ""                       # route53 only; empty = same as domain_name
attach_domain      = false
