# Copy this file to ".env" and fill in your values. Lines starting with "#" are comments.

# --- AI service (Groq) ---
# Your Groq API key (get one at console.groq.com). Required.
GROQ_API_KEY=
# Groq deprecated the Llama 3.x defaults; check console.groq.com/docs/deprecations before changing.
# The large, high-quality model used for the debate arguments.
GROQ_MODEL_MAIN=openai/gpt-oss-120b
# The smaller, faster model used for short jobs (topic summary, bias scoring, opinion replies).
GROQ_MODEL_FAST=openai/gpt-oss-20b
# How many times the Groq client retries a failed request.
GROQ_MAX_RETRIES=5

# --- News sources: set at least one ---
NEWSAPI_KEY=
GNEWS_API_KEY=

# --- Database ---
# Where Redis is. "localhost" works when running outside Docker; Docker Compose overrides it.
REDIS_URL=redis://localhost:6379

# --- Optional LangSmith tracing (shows each LLM call in a web dashboard) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=counterpoint

# Daily job. Set SCHEDULER_ENABLED=false if something else (e.g. EventBridge) calls POST /internal/run-daily.
# Run the built-in daily timer inside the backend.
SCHEDULER_ENABLED=true
# Time of day it runs (hour 0-23 and minute) in the timezone below.
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=UTC
# Let the moderator ask the analysts for one extra round when a point is left unresolved (costs ~6 more LLM calls).
SECOND_ROUND_ENABLED=true
# Required to enable POST /internal/run-daily (send as X-Admin-Token). Use a long random value.
ADMIN_TOKEN=

# Guardrails load torch/spaCy models. Disable only for local dev.
# How much detail the logs contain (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# json = one object per line, for CloudWatch and other log shippers
LOG_FORMAT=text

# --- Safety filters and limits ---
# Turn the AI safety checks on (true) or off (false).
GUARDRAILS_ENABLED=true
# How many times a blocked rebuttal is regenerated before it is dropped.
MAX_REBUTTAL_RETRIES=2
# The longest opinion (in characters) a user may submit.
MAX_OPINION_CHARS=1000
# Opinions allowed per client in each time window...
OPINION_RATE_LIMIT=10
# ...and the length of that window, in seconds.
OPINION_RATE_WINDOW_SECONDS=60
# A cap on opinions across ALL users per hour (0 turns the cap off).
OPINION_GLOBAL_LIMIT_PER_HOUR=300
# Behind a load balancer set true, and TRUSTED_PROXY_HOPS to the number of proxies (ALB=1, CloudFront+ALB=2).
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# --- Website / browser settings ---
# Which website addresses may call the API from a browser (CORS).
CORS_ORIGINS=http://localhost:3000
# Where the browser finds the API and the WebSocket (used when building the frontend).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
